rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isAcceptedFriend(otherUid) {
      let friendship = get(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, otherUid)));
      return friendship.data.status == 'accepted';
    }

    // Public-ish profile data, readable by any signed-in user so friend search
    // and friend-list rendering work; only the owner can write their own doc.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // A location doc is only visible to its owner and to accepted friends.
    match /locations/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAcceptedFriend(uid));
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Friendship doc id is the sorted "uidA_uidB" pair.
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && friendshipId == pairId(request.resource.data.users[0], request.resource.data.users[1]);

      // Only the recipient can accept/decline; either side can update after that
      // point is not allowed, since status transitions are one-way from 'pending'.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.users
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if isSignedIn() && request.auth.uid in resource.data.users;
    }
  }
}
